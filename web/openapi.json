        }
      },
      "AssetBoardResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "source": { "type": "string", "enum": ["all", "main", "concept"] },
              "statusFilter": { "type": "string" },
              "limit": { "type": "integer" },
              "offset": { "type": "integer" },
              "totalCount": { "type": "integer" },
              "count": { "type": "integer" },
              "items": { "type": "array", "items": { "$ref": "#/components/schemas/AssetItem" } },
              "credits": { "type": "object", "description": "main / concept 积分快照" },
              "endpoints": { "type": "object" },
              "hint": { "type": "string" }
            }
          }
        }
      },
      "AssetItem": {
        "type": "object",
