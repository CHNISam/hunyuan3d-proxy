          "prompt": { "type": "string" },
          "status": { "type": "string", "enum": ["processing", "success", "failed", "unknown"] },
          "progress": {},
          "pipeline": {},
          "modelType": { "type": "string" },
          "style": { "type": "string" },
          "createdAt": {},
          "updatedAt": {},
          "error": { "type": "string" },
          "previewUrl": { "type": "string", "format": "uri" },
          "primaryModelUrl": { "type": "string", "format": "uri" },
          "assets": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" }, "description": "展平的中间产物 URL 表（geometry / PBR / 视图 / glb / fbx…）" },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
